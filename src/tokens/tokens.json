{
  "$schema": "rvhl-tokens/1.0",
  "spec": "RVHL",
  "version": "1.0.0",
  "notes": "Central RoadOS design tokens. All composed icons, previews and exports read these values. Values are RoadOS proposals and are not official standard values unless a frame explicitly mirrors convention geometry.",
  "severity": {
    "S1": { "label": "Informational", "color": "#8296A5", "onColor": "#0B1118", "priority": 1 },
    "S2": { "label": "Low caution", "color": "#E2C34C", "onColor": "#0B1118", "priority": 2 },
    "S3": { "label": "Moderate caution", "color": "#E99A32", "onColor": "#0B1118", "priority": 3 },
    "S4": { "label": "High danger", "color": "#E35D32", "onColor": "#FFFFFF", "priority": 4 },
    "S5": { "label": "Critical danger", "color": "#D93636", "onColor": "#FFFFFF", "priority": 5 }
  },
  "convention": {
    "signRed": "#C8102E",
    "signBlue": "#1F4E9E",
    "signGreen": "#0F6B3A",
    "signWhite": "#FFFFFF",
    "signBlack": "#111111",
    "signYellow": "#F5C400",
    "signalRed": "#FF3B30",
    "signalAmber": "#FFB000",
    "signalGreen": "#22C55E",
    "markingWhite": "#F4F4F0",
    "markingYellow": "#F2C230",
    "water": "#3FA9F5",
    "notes": "Convention colours are RoadOS screen approximations for preview only. They are not colorimetric specifications from any standard."
  },
  "shapes": {
    "warning_triangle": { "class": "warning", "basis": "convention", "description": "Equilateral triangle, red border, white field, point up." },
    "prohibitory_circle": { "class": "regulatory", "basis": "convention", "description": "Circle, red border, white field, optional red diagonal bar." },
    "mandatory_circle": { "class": "regulatory", "basis": "convention", "description": "Circle, blue field, white symbol." },
    "stop_octagon": { "class": "regulatory", "basis": "convention", "description": "Octagon, red field, white legend." },
    "give_way_triangle": { "class": "regulatory", "basis": "convention", "description": "Inverted triangle, red border, white field." },
    "info_rect": { "class": "informatory", "basis": "convention", "description": "Blue rectangle with white symbol panel." },
    "direction_board": { "class": "informatory", "basis": "convention", "description": "Green rectangular board with white legend." },
    "roados_hazard": { "class": "hazard", "basis": "roados", "description": "RoadOS rounded square, dark field, severity-coloured border, severity code tab." },
    "roados_marking": { "class": "marking", "basis": "roados", "description": "RoadOS pavement tile: small-radius square with asphalt field." },
    "roados_infrastructure": { "class": "infrastructure", "basis": "roados", "description": "RoadOS arch-top tile: rounded top, square base." },
    "roados_signal": { "class": "signal", "basis": "roados", "description": "RoadOS signal tile: rounded rectangle housing frame." },
    "roados_context": { "class": "context", "basis": "roados", "description": "RoadOS hexagon for vehicle context information." }
  },
  "stroke": { "hairline": 1, "thin": 2.5, "regular": 4, "bold": 6, "frame": 6, "signBorder": 8 },
  "radius": { "tile": 6, "hazard": 20, "signal": 14, "chip": 8, "pill": 9, "badge": 6 },
  "icon": {
    "pictogramViewBox": [0, 0, 64, 64],
    "pictogramSafeArea": [4, 4, 60, 60],
    "composedViewBox": [0, 0, 128, 128],
    "frameBox": [16, 6, 96, 96],
    "previewSizes": [16, 24, 32, 48, 64, 96, 128],
    "minimumRecommendedPx": 24
  },
  "typography": {
    "family": "Inter, 'Segoe UI', Roboto, Arial, sans-serif",
    "numeralFamily": "'DIN Alternate', 'Barlow Condensed', 'Roboto Condensed', Arial Narrow, sans-serif",
    "monoFamily": "'JetBrains Mono', 'SF Mono', Menlo, monospace",
    "weightRegular": 500,
    "weightBold": 800,
    "badgeSize": 15,
    "distanceSize": 12,
    "instrumentSize": 72
  },
  "spacing": { "xs": 2, "sm": 4, "md": 8, "lg": 12, "xl": 16 },
  "badges": {
    "distance": { "height": 18, "radius": 9, "fill": "#0B1118", "stroke": "#3A4A5A", "text": "#F2F5F7" },
    "postedSpeed": { "radius": 20, "ring": "#C8102E", "ringWidth": 5, "fill": "#FFFFFF", "text": "#111111" },
    "advisorySpeed": { "width": 40, "height": 30, "radius": 6, "fill": "#0B1118", "stroke": "#E2C34C", "strokeWidth": 3, "text": "#E2C34C", "label": "ADV" },
    "unknownSpeed": { "fill": "#1A2430", "ring": "#5A6B7A", "text": "#8296A5" },
    "count": { "radius": 13, "fill": "#F2F5F7", "text": "#0B1118" },
    "chip": { "fill": "#0B1118", "stroke": "#3A4A5A", "text": "#F2F5F7" }
  },
  "backgrounds": { "dark": "#0B1118", "darkRaised": "#111A24", "light": "#EEF1F4", "lightRaised": "#FFFFFF", "map": "#0E151D", "asphalt": "#2A3138" },
  "borders": { "dark": "#1E2A36", "darkStrong": "#2C3B4A", "light": "#C9D2DA" },
  "themes": {
    "dark": {
      "frameFill": "#0F1720",
      "markingFill": "#2A3138",
      "infraFill": "#111C29",
      "contextFill": "#0F1C2E",
      "ink": "#F2F5F7",
      "inkMuted": "#8EA0B0",
      "accentBlue": "#4C8DF6",
      "halo": "#000000"
    },
    "light": {
      "frameFill": "#FFFFFF",
      "markingFill": "#4A535C",
      "infraFill": "#F3F6F9",
      "contextFill": "#EAF1FD",
      "ink": "#111821",
      "inkMuted": "#51606E",
      "accentBlue": "#1F5FD1",
      "halo": "#FFFFFF"
    }
  }
}
